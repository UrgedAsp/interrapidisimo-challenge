PORT=3001
# Obligatoria, mínimo 32 caracteres. La app no arranca sin ella.
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-verdad
JWT_EXPIRES_IN=1h
# Costo de bcrypt para el seed. Las pruebas lo bajan a 4.
BCRYPT_ROUNDS=10
DATABASE_PATH=./data/app.db
# Único origen con CORS habilitado (§1)
FRONTEND_ORIGIN=http://localhost:5173
